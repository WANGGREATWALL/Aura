        <mxCell id="d_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_hub" target="d_inflight">
