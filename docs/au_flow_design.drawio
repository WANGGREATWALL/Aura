        <mxCell id="b_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_a" target="b_c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_b" target="b_d">
