        </mxCell>
        <mxCell id="f_road_text" value="P0：修 mm 构建、DAG + CPU + task/block/waitThrough + DOT    →    P1：动态 block、取消/错误    →    P2：OpenCL event/lease/回退    →    P3：dma-buf 导入与多队列优化" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fontStyle=1;" vertex="1" parent="f_road">
          <mxGeometry x="25" y="42" width="1670" height="38" as="geometry" />
        </mxCell>
        <mxCell id="f_note" value="验收：拓扑/并发 race、无丢唤醒、取消 drain、CPU/GPU 数据正确性、fd/event 零泄漏、背压、Android 与 macOS 回退、性能基线。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fontStyle=1;" vertex="1" parent="f_road">
          <mxGeometry x="25" y="89" width="1670" height="38" as="geometry" />
        </mxCell>
