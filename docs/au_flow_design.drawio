        </mxCell>
        <mxCell id="g_n2" value="XMemory / MemBlock&#xa;move-only；ptr/size/fd/backend；&#xa;DMA_BUF_IOCTL_SYNC 缓存操作" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#F1F3F5;strokeColor=#7A858F;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="g_now">
          <mxGeometry x="20" y="330" width="470" height="118" as="geometry" />
        </mxCell>
        <mxCell id="g_r2" value="无 image plane/stride/format/modifier 描述；&#xa;无异步 in-flight 引用；fd 与 cl_mem&#xa;可能早于 kernel 完成而释放" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#FDEBEA;strokeColor=#BC635B;strokeWidth=1.5;" vertex="1" parent="g_gap">
