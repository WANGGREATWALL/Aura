        <mxCell id="b_validate" value="seal 校验&#xa;ID 唯一 / 无环 / 边合法&#xa;资源读写冲突需要显式依赖" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#E9F6F0;strokeColor=#318569;strokeWidth=1.5;" vertex="1" parent="b_rules">
          <mxGeometry x="20" y="60" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="b_cross" value="跨 block 注册&#xa;仅引用已创建的前驱；原子注册&#xa;先登记依赖，再允许新节点就绪" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FFF3DD;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="b_rules">
          <mxGeometry x="20" y="270" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="b_dynamic" value="运行时动态提交&#xa;新 block 或子任务容器&#xa;不得改动已提交 block 的边" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FFF3DD;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="b_rules">
          <mxGeometry x="20" y="480" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="b_note" value="资源描述：读/写域、设备、Image/Buffer、格式/步长/plane；提交时固定快照。任务载荷和跨线程拥有关系须明确。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="970" width="1690" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="03 调度与同步状态机" id="03">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header" value="03 调度与同步状态机" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#FFFFFF;fillColor=#19334B;strokeColor=#19334B;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1720" height="58" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="完成信号是统一调度语义：CPU 函数返回或 OpenCL event 到终态后，才递减后继的待完成前驱数。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#506477;" vertex="1" parent="1">
          <mxGeometry x="50" y="96" width="1700" height="45" as="geometry" />
        </mxCell>
        <mxCell id="source" value="设计约定：release/acquire 发布结果；waitAll 使用提交 epoch 快照；取消不抢占运行中 CPU / GPU 命令。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#506477;" vertex="1" parent="1">
          <mxGeometry x="50" y="1030" width="1700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c_life" value="单 task 状态迁移" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#E9F6F0;swimlaneFillColor=#FFFFFF;strokeColor=#318569;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="1720" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c_new" value="BUILT&#xa;可编辑" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#EAF2FF;strokeColor=#4672B8;strokeWidth=1.5;" vertex="1" parent="c_life">
          <mxGeometry x="35" y="85" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_seal" value="SEALED&#xa;只读" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#E9F6F0;strokeColor=#318569;strokeWidth=1.5;" vertex="1" parent="c_life">
          <mxGeometry x="275" y="85" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_wait" value="WAITING&#xa;pending &gt; 0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FFF3DD;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="c_life">
          <mxGeometry x="515" y="85" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_ready" value="READY&#xa;pending = 0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FFF3DD;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="c_life">
          <mxGeometry x="755" y="85" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_run" value="RUNNING&#xa;CPU 执行 / GPU 入队" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#F0EAFB;strokeColor=#8062AB;strokeWidth=1.5;" vertex="1" parent="c_life">
          <mxGeometry x="995" y="85" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_flight" value="GPU_IN_FLIGHT&#xa;持有 event + lease" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#F0EAFB;strokeColor=#8062AB;strokeWidth=1.5;" vertex="1" parent="c_life">
          <mxGeometry x="1235" y="85" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_done" value="TERMINAL&#xa;Done / Failed / Cancelled" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#E9F6F0;strokeColor=#318569;strokeWidth=1.5;" vertex="1" parent="c_life">
          <mxGeometry x="1475" y="85" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_s0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_new" target="c_seal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_seal" target="c_wait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_wait" target="c_ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_ready" target="c_run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_run" target="c_flight">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_flight" target="c_done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_cpu_skip" value="CPU 返回可直接进入 TERMINAL；GPU 命令入队成功只进入 GPU_IN_FLIGHT，不代表完成。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#19334B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="1610" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_rules" value="并发协议 / 等待 / 错误" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#FFF3DD;swimlaneFillColor=#FFFFFF;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="1720" height="450" as="geometry" />
        </mxCell>
        <mxCell id="c_dep" value="DependencyEngine&#xa;每节点 atomic pending；前驱 terminal release&#xa;fetch_sub(acq_rel)==1 → ready 发布" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#E9F6F0;strokeColor=#318569;strokeWidth=1.5;" vertex="1" parent="c_rules">
          <mxGeometry x="25" y="65" width="395" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c_waits" value="WaitRegistry&#xa;TaskHandle.wait：该节点 terminal&#xa;BlockHandle.wait：块内全 terminal + cleanup" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#EAF2FF;strokeColor=#4672B8;strokeWidth=1.5;" vertex="1" parent="c_rules">
          <mxGeometry x="445" y="65" width="395" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c_all" value="waitAll() = waitThrough(snapshotEpoch())&#xa;入队时分配递增 epoch；等待 &lt;= E&#xa;之后提交的 block 不纳入本次等待" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#EAF2FF;strokeColor=#4672B8;strokeWidth=1.5;" vertex="1" parent="c_rules">
          <mxGeometry x="865" y="65" width="395" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c_fail" value="错误与取消&#xa;首错或错误集合保存在 block；默认阻断后继&#xa;仅取消未启动节点；在途 GPU drain" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FDEBEA;strokeColor=#BC635B;strokeWidth=1.5;" vertex="1" parent="c_rules">
          <mxGeometry x="1285" y="65" width="395" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c_worker" value="worker 内 wait 防死锁&#xa;优先协作执行就绪任务；不可协作时返回错误&#xa;禁止同步等待自身或依赖环" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FFF3DD;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="c_rules">
          <mxGeometry x="25" y="255" width="510" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c_race" value="跨 block 接入顺序&#xa;前驱可能并发完成：先注册后检查终态&#xa;使用锁/代际握手避免丢失通知" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FFF3DD;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="c_rules">
          <mxGeometry x="595" y="255" width="510" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c_stop" value="shutdown 与背压&#xa;停止准入 → 取消待运行 / drain 在途 → 释放 lease&#xa;有界 task/event 队列及超限错误码" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FFF3DD;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="c_rules">
          <mxGeometry x="1165" y="255" width="510" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c_note" value="不变量：每个节点只完成一次；每条依赖只消费一次；最后一个前驱释放就绪；所有 waiter 最终由终态广播唤醒。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="970" width="1690" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="04 CPU / OpenCL 异构执行" id="04">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header" value="04 CPU / OpenCL 异构执行" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#FFFFFF;fillColor=#19334B;strokeColor=#19334B;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1720" height="58" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="同一图统一表达依赖；CPU worker 只负责 CPU 函数，GPU 提交与完成回收由独立通道处理。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#506477;" vertex="1" parent="1">
          <mxGeometry x="50" y="96" width="1700" height="45" as="geometry" />
        </mxCell>
        <mxCell id="source" value="现有 CLWrapper::enqueue 返回 cl::Event，但当前无 wait list 入参且 mOffset/mGlobal/mLocal 为共享可变状态；适配层需新增命令描述。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#506477;" vertex="1" parent="1">
          <mxGeometry x="50" y="1030" width="1700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d_cpu" value="Scheduler / CPU worker" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#FFF3DD;swimlaneFillColor=#FFFFFF;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="420" height="790" as="geometry" />
        </mxCell>
        <mxCell id="d_submit" value="GPU submit lane · 每设备/队列" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#F0EAFB;swimlaneFillColor=#FFFFFF;strokeColor=#8062AB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="490" y="170" width="500" height="790" as="geometry" />
        </mxCell>
        <mxCell id="d_device" value="OpenCL device / completion" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#E9F5F8;swimlaneFillColor=#FFFFFF;strokeColor=#408CA0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1020" y="170" width="740" height="790" as="geometry" />
        </mxCell>
        <mxCell id="d_ready" value="依赖满足的 task&#xa;CPU 或 OpenCL kind" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#E9F6F0;strokeColor=#318569;strokeWidth=1.5;" vertex="1" parent="d_cpu">
          <mxGeometry x="30" y="70" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d_cpu_run" value="CPU task 执行&#xa;同步返回 Status" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#EAF2FF;strokeColor=#4672B8;strokeWidth=1.5;" vertex="1" parent="d_cpu">
          <mxGeometry x="30" y="295" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d_release" value="统一 complete(task,status)&#xa;传播后继 + 唤醒等待" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#E9F6F0;strokeColor=#318569;strokeWidth=1.5;" vertex="1" parent="d_cpu">
          <mxGeometry x="30" y="570" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d_command" value="OpenClCommand 描述&#xa;queue / kernel / NDRange / 参数&#xa;wait events / BufferLease" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#F0EAFB;strokeColor=#8062AB;strokeWidth=1.5;" vertex="1" parent="d_submit">
          <mxGeometry x="30" y="70" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="d_enqueue" value="clEnqueue* 非阻塞提交&#xa;返回 cl_event；提交失败立即 complete" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#F0EAFB;strokeColor=#8062AB;strokeWidth=1.5;" vertex="1" parent="d_submit">
          <mxGeometry x="30" y="320" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d_inflight" value="InFlightTable&#xa;(task id, cl_event, leases, deadline)&#xa;有界容量 + ownership" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#F0EAFB;strokeColor=#8062AB;strokeWidth=1.5;" vertex="1" parent="d_submit">
          <mxGeometry x="30" y="580" width="440" height="115" as="geometry" />
        </mxCell>
        <mxCell id="d_gpu" value="设备执行 kernel&#xa;event 从 QUEUED → COMPLETE / error" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#F0EAFB;strokeColor=#8062AB;strokeWidth=1.5;" vertex="1" parent="d_device">
          <mxGeometry x="30" y="70" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="d_callback" value="CL event callback / poller&#xa;仅投递完成 token；不运行用户代码" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#E9F5F8;strokeColor=#408CA0;strokeWidth=1.5;" vertex="1" parent="d_device">
          <mxGeometry x="380" y="70" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="d_hub" value="CompletionHub&#xa;读取 event status / profiling&#xa;回收事件和 leases" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#E9F5F8;strokeColor=#408CA0;strokeWidth=1.5;" vertex="1" parent="d_device">
          <mxGeometry x="380" y="320" width="310" height="125" as="geometry" />
        </mxCell>
        <mxCell id="d_waitlist" value="GPU → GPU 可选优化&#xa;同 context/queue 的前驱 event 作为 wait list&#xa;逻辑完成仍以本节点 event 为准" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FFF3DD;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="d_device">
          <mxGeometry x="30" y="580" width="650" height="115" as="geometry" />
        </mxCell>
        <mxCell id="d_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_ready" target="d_cpu_run">
          <mxGeometry relative="1" as="geometry" />
