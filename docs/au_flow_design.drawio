  <diagram name="07 现有组件改造清单" id="07">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header" value="07 现有组件改造清单" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#FFFFFF;fillColor=#19334B;strokeColor=#19334B;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1720" height="58" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="把现有代码可复用的部分接入新调度器，并将接口、并发、内存与构建问题列为明确的迁移项。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#506477;" vertex="1" parent="1">
          <mxGeometry x="50" y="96" width="1700" height="45" as="geometry" />
        </mxCell>
        <mxCell id="source" value="事实依据：Aura/src/flow/xthread*.h、src/gpu_helper/cl_wrapper.h、inc/mm/xmemory.h、src/mm/xmemory.cpp；右列是设计建议。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#506477;" vertex="1" parent="1">
          <mxGeometry x="50" y="1030" width="1700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="g_now" value="现有实现 · 保留 / 适配" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#F1F3F5;swimlaneFillColor=#FFFFFF;strokeColor=#7A858F;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="510" height="770" as="geometry" />
        </mxCell>
        <mxCell id="g_gap" value="当前缺口 / 风险" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#FDEBEA;swimlaneFillColor=#FFFFFF;strokeColor=#BC635B;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="580" y="170" width="510" height="770" as="geometry" />
        </mxCell>
        <mxCell id="g_change" value="拟修改方案 · 可验收" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#E9F6F0;swimlaneFillColor=#FFFFFF;strokeColor=#318569;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1120" y="170" width="640" height="770" as="geometry" />
        </mxCell>
        <mxCell id="g_n0" value="XFlow / XThreadpool&#xa;两个 pool；std::function + 单队列 + mutex&#xa;packaged_task/future；无 DAG" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#F1F3F5;strokeColor=#7A858F;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="g_now">
          <mxGeometry x="20" y="50" width="470" height="118" as="geometry" />
        </mxCell>
        <mxCell id="g_r0" value="任务提交热路径分配并争用全局锁；&#xa;停止后 enqueue 抛异常；无法表达&#xa;依赖或单 task / block 完成" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#FDEBEA;strokeColor=#BC635B;strokeWidth=1.5;" vertex="1" parent="g_gap">
          <mxGeometry x="20" y="50" width="470" height="118" as="geometry" />
        </mxCell>
        <mxCell id="g_c0" value="保留 XFlow 兼容入口；新增 SchedulerCore&#xa;与 task/block handle；旧 API 映射到单节点 block；&#xa;内部有界队列/批量提交，ABI 返回错误码" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#E9F6F0;strokeColor=#318569;strokeWidth=1.5;" vertex="1" parent="g_change">
          <mxGeometry x="20" y="50" width="600" height="118" as="geometry" />
        </mxCell>
        <mxCell id="g_e0a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_n0" target="g_r0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g_e0b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_r0" target="g_c0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g_n1" value="CLWrapper::setNDRange + enqueue&#xa;共享 mOffset/mGlobal/mLocal / mEvents；&#xa;命令 wait list 传 nullptr" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#F1F3F5;strokeColor=#7A858F;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="g_now">
          <mxGeometry x="20" y="190" width="470" height="118" as="geometry" />
        </mxCell>
        <mxCell id="g_r1" value="并发配置可能串扰；GPU 前驱 event&#xa;不能直接传递；内部事件表增长和&#xa;生命周期与调度器脱节" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#FDEBEA;strokeColor=#BC635B;strokeWidth=1.5;" vertex="1" parent="g_gap">
          <mxGeometry x="20" y="190" width="470" height="118" as="geometry" />
        </mxCell>
        <mxCell id="g_c1" value="新增不可变 OpenClCommand 参数；显式 waitEvents；&#xa;每设备 submit lane；event 交 InFlightTable 管理；&#xa;CLWrapper 保留构建/内核缓存服务" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#E9F6F0;strokeColor=#318569;strokeWidth=1.5;" vertex="1" parent="g_change">
          <mxGeometry x="20" y="190" width="600" height="118" as="geometry" />
