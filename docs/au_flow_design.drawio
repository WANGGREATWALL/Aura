  <diagram name="05 OpenCL 内存与生命周期" id="05">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header" value="05 OpenCL 内存与生命周期" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#FFFFFF;fillColor=#19334B;strokeColor=#19334B;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1720" height="58" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="BufferLease 将 XMemory、导入的 cl_mem、fd 和在途 cl_event 绑定到 task 完成；显式区分缓存同步与执行完成。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#506477;" vertex="1" parent="1">
          <mxGeometry x="50" y="96" width="1700" height="45" as="geometry" />
        </mxCell>
        <mxCell id="source" value="现有 mm::XMemory 管理 MemBlock(ptr,size,fd) 和 DMA_BUF_IOCTL_SYNC；CLWrapper 默认 CL_MEM_USE_HOST_PTR，不等于 dma-buf 零拷贝导入。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#506477;" vertex="1" parent="1">
          <mxGeometry x="50" y="1030" width="1700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="e_owner" value="分配 / 元数据" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#E9F5F8;swimlaneFillColor=#FFFFFF;strokeColor=#408CA0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="410" height="790" as="geometry" />
        </mxCell>
        <mxCell id="e_import" value="互操作能力与路径" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#F0EAFB;swimlaneFillColor=#FFFFFF;strokeColor=#8062AB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="480" y="170" width="510" height="790" as="geometry" />
        </mxCell>
        <mxCell id="e_run" value="GPU 在途与完成" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#FFF3DD;swimlaneFillColor=#FFFFFF;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1020" y="170" width="420" height="790" as="geometry" />
        </mxCell>
        <mxCell id="e_cpu" value="CPU 访问与清理" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#EAF2FF;swimlaneFillColor=#FFFFFF;strokeColor=#4672B8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1470" y="170" width="290" height="790" as="geometry" />
        </mxCell>
        <mxCell id="e_xmem" value="XMemory / MemBlock&#xa;ptr + size + fd + backend&#xa;move-only RAII" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#F1F3F5;strokeColor=#7A858F;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="e_owner">
          <mxGeometry x="25" y="60" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e_meta" value="Image/Buffer 描述&#xa;plane fd / offset / stride / format&#xa;size / modifier / access flags" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#E9F5F8;strokeColor=#408CA0;strokeWidth=1.5;" vertex="1" parent="e_owner">
          <mxGeometry x="25" y="295" width="360" height="135" as="geometry" />
        </mxCell>
        <mxCell id="e_lease" value="BufferLease&#xa;持有 XMemory/导入对象和依赖 event&#xa;最后一个异步使用完成后释放" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#E9F5F8;strokeColor=#408CA0;strokeWidth=1.5;" vertex="1" parent="e_owner">
          <mxGeometry x="25" y="570" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e_probe" value="InteropProvider::probe&#xa;设备扩展 / format / modifier / fence&#xa;只在支持时选择零拷贝" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#F0EAFB;strokeColor=#8062AB;strokeWidth=1.5;" vertex="1" parent="e_import">
          <mxGeometry x="25" y="60" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e_dmabuf" value="dma-buf 导入路径&#xa;平台 API 及 acquire/release 由 au::sys 隔离&#xa;验证 fd 所有权和共享域" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#F0EAFB;strokeColor=#8062AB;strokeWidth=1.5;" vertex="1" parent="e_import">
          <mxGeometry x="25" y="290" width="450" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_copy" value="便携回退路径&#xa;普通 cl_mem + 显式拷贝/映射&#xa;macOS 或不支持导入的设备" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FFF3DD;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="e_import">
          <mxGeometry x="25" y="570" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e_submit" value="submit(kernel, leases, waitEvents)&#xa;入队成功产生 cl_event&#xa;标记资源 GPU_IN_FLIGHT" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#F0EAFB;strokeColor=#8062AB;strokeWidth=1.5;" vertex="1" parent="e_run">
          <mxGeometry x="25" y="60" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e_event" value="event terminal / fence 完成&#xa;处理负状态；必要时 acquire/release&#xa;通知所有依赖消费者" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FFF3DD;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="e_run">
          <mxGeometry x="25" y="300" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e_release" value="完成回收&#xa;引用归零后释放 cl_mem / event / fd&#xa;先解除 GPU 引用，再释放分配" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#E9F5F8;strokeColor=#408CA0;strokeWidth=1.5;" vertex="1" parent="e_run">
          <mxGeometry x="25" y="570" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e_cpu_write" value="CPU 写→GPU 读&#xa;结束 CPU 写域 / flush cache&#xa;再 enqueue + event wait" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#EAF2FF;strokeColor=#4672B8;strokeWidth=1.5;" vertex="1" parent="e_cpu">
          <mxGeometry x="20" y="60" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e_cpu_read" value="GPU 写→CPU 读&#xa;先等 event/fence terminal&#xa;再 invalidate cache / map" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#EAF2FF;strokeColor=#4672B8;strokeWidth=1.5;" vertex="1" parent="e_cpu">
          <mxGeometry x="20" y="300" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e_sync" value="DMA_BUF_IOCTL_SYNC&#xa;仅处理 CPU cache 可见性&#xa;不能替代 cl_event 完成" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fillColor=#FDEBEA;strokeColor=#BC635B;strokeWidth=1.5;" vertex="1" parent="e_cpu">
          <mxGeometry x="20" y="570" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_xmem" target="e_meta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_meta" target="e_lease">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_meta" target="e_probe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_probe" target="e_dmabuf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_dmabuf" target="e_submit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_submit" target="e_event">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_event" target="e_release">
          <mxGeometry relative="1" as="geometry" />
