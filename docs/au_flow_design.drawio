        <mxCell id="e_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#718396;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=12;fontColor=#43576A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_event" target="e_cpu_read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_note" value="资源键至少包含：device/context + allocation id + plane + format；复用池须记录最后 GPU writer/reader event，禁止在途覆盖和提前 close(fd)。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#19334B;fontStyle=1;" vertex="1" parent="1">
