        <mxCell id="g_n3" value="src/mm/xmemory.cpp&#xa;CMake 已编入；源码第 105/125/157/192 行&#xa;含字面 Markdown ``` 标记" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#F1F3F5;strokeColor=#7A858F;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="g_now">
