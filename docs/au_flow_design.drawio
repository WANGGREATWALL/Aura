        </mxCell>
        <mxCell id="g_c2" value="XMemory 继续拥有分配；增 ImageLayout 与 BufferLease；&#xa;CL 导入能力探测及拷贝回退；event terminal&#xa;后统一释放，CPU cache sync 与执行 fence 分离" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#E9F6F0;strokeColor=#318569;strokeWidth=1.5;" vertex="1" parent="g_change">
