        <mxCell id="f_road" value="实施顺序与验收门槛" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;pointerEvents=0;html=1;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#19334B;fillColor=#FFF3DD;swimlaneFillColor=#FFFFFF;strokeColor=#BA8738;strokeWidth=1.5;" vertex="1" parent="1">
