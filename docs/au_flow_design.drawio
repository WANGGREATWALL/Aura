        <mxCell id="g_n4" value="CLWrapper::build / SVM&#xa;默认 -cl-std=CL2.0；SVM 功能&#xa;与设备能力未在接口层隔离" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#F1F3F5;strokeColor=#7A858F;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="g_now">
