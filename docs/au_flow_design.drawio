        <mxCell id="g_r4" value="固定编译标准在低版本设备可能失败；&#xa;SVM / image 格式不能只按编译期开关&#xa;判断，影响 Android 与 macOS 回退" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=13;fontColor=#19334B;fillColor=#FDEBEA;strokeColor=#BC635B;strokeWidth=1.5;" vertex="1" parent="g_gap">
